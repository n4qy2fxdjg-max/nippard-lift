# --- Database ---------------------------------------------------------------
# Local development (SQLite). The file is created on first migrate.
DATABASE_URL="file:./prisma/dev.db"
# Production (PostgreSQL, e.g. Neon / Supabase / Vercel Postgres). Also set
# `provider = "postgresql"` in prisma/schema.prisma before migrating.
# DATABASE_URL="postgresql://user:password@host:5432/nadir?sslmode=require"

# --- App ---------------------------------------------------------------------
# Public origin used in QR codes and survey links. Leave empty to infer from the request.
NEXT_PUBLIC_APP_URL=""
# Protects /admin and the admin API in production. Leave empty to allow open access (local play).
ADMIN_PASSWORD=""
# Enables the host debug / demo panel (forced scores, skip to Head-to-Head / Final).
NEXT_PUBLIC_ENABLE_DEBUG="true"
